# Build-time defaults for a packaged release. None of these are secrets — they
# are baked into the bundle, so never put a private key or an application key
# here. Secrets belong in CI secrets (see docs/RELEASING.md) or in Settings on
# the station itself.

# Where releases are hosted. The app polls ${APP_UPDATE_BASE_URL}/latest.json,
# the single signed manifest the release workflow deploys.
APP_UPDATE_BASE_URL=https://jamalgillis.github.io/CsnMediaBridge

# Operator sign-in. Both are public OAuth coordinates, not secrets. Leaving them
# empty ships an ungated build: no sign-in, every screen reachable. They can also
# be set per station under Settings, which is what lets one white-label build
# serve several Clerk instances. See docs/AUTHENTICATION.md.
CLERK_OAUTH_ISSUER=
CLERK_OAUTH_CLIENT_ID=

# Public backend coordinates, so a fresh station does not have to be told where
# everything lives before it can do anything. Access keys are not included and
# are entered per workstation in Settings.
# CSN_B2_BUCKET=csn-masters
# CSN_B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# CSN_R2_ACCOUNT_ID=
# CSN_R2_BUCKET=csn-dist
# CSN_R2_PUBLIC_BASE_URL=https://cdn.csn.com
# CSN_CONVEX_DEPLOYMENT_URL=https://csn-sports.convex.cloud
# CSN_CONVEX_MUTATION_PATH=media/videos:createVodEntry

# Future macOS signing placeholders if you later join the Apple Developer Program.
# APPLE_SIGN_ENABLED=true
# APPLE_SIGN_IDENTITY=Developer ID Application: Your Company, Inc. (TEAMID1234)
# APPLE_KEYCHAIN_PROFILE=csn-media-bridge-notary
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID1234
