{
  "name": "csn-media-bridge",
  "productName": "Media Bridge",
  "version": "1.0.4",
  "description": "Cross-platform Tauri ingest station for automated VOD transcoding and cloud sync.",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "tauri dev",
    "start": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icons": "node scripts/create-tauri-rgba-icon.mjs",
    "renderer:dev": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "renderer:build": "vite build --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx .",
    "host:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "host:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:resume": "node --experimental-strip-types scripts/test-resume.mjs",
    "archive:stream": "node scripts/archive-stream-to-b2.mjs",
    "release:check": "pnpm run typecheck && pnpm run lint && pnpm run test:resume && pnpm run host:test",
    "migrate:library": "node scripts/migrate-to-sports-deployment.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "decommission:old-backend": "bash scripts/decommission-old-backend.sh",
    "check:connection": "node scripts/check-connection.mjs"
  },
  "keywords": [],
  "author": "jamalgillis",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.4.5",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "hls.js": "^1.7.2",
    "plyr": "^3.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  }
}
