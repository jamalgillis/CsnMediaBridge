{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSN Media Bridge",
  "version": "1.0.0",
  "identifier": "com.gfamagency.csnmediabridge",
  "build": {
    "beforeDevCommand": "pnpm run renderer:dev",
    "beforeBuildCommand": "pnpm run renderer:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CSN Media Bridge",
        "width": 1560,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 760,
        "backgroundColor": "#050505",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.icns",
      "../assets/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://downloads.example.com/csn-media-bridge/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RkZDM0UzNUZDQzcwQQpSV1FLeC93MVB2eC9DeXIvTE81VFhhV1pvZ0U0QUpCMENFVDNpbkpqSkI0Zldzb3RQaHMvV0xHbgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
