{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSN Media Bridge",
  "version": "1.0.0",
  "identifier": "com.gfamagency.csnmediabridge",
  "build": {
    "beforeDevCommand": "pnpm run renderer:dev",
    "beforeBuildCommand": "pnpm run renderer:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CSN Media Bridge",
        "width": 1560,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 760,
        "backgroundColor": "#09111d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.icns",
      "../assets/icon.ico"
    ]
  }
}
