{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Bridge",
  "version": "1.0.2",
  "identifier": "com.gfamagency.mediabridge",
  "build": {
    "beforeDevCommand": "pnpm run renderer:dev",
    "beforeBuildCommand": "pnpm run renderer:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Media Bridge",
        "width": 1560,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 760,
        "backgroundColor": "#050505",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: http: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; media-src 'self' asset: blob: http: https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.icns",
      "../assets/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://jamalgillis.github.io/CsnMediaBridge/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyNERDMTJFOEI0QTY3MkYKUldRdlowcUxMc0ZOVXN2N0tMdjJTVUJUZkZ4QmVyMDN4aDZ5UDJSdVF0cm1sSXFuN2hod2IybUUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
